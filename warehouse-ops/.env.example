# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API). Never commit .env.local.

# Public values — safe in the browser. Row Level Security limits what they can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The public URL of this app, used in sign-up confirmation and invitation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This app does NOT need the Supabase service-role key. Do not add it here.
