# --- Gemini Multimodal Live API (required for Live Camera & Voice mode) ---
# Server-only. Used by /api/live/token to mint short-lived, single-use ephemeral
# tokens. Never prefix with NEXT_PUBLIC_ and never send it to the browser.
GEMINI_API_KEY=

# Optional: override the Live model (defaults to gemini-2.5-flash-native-audio-preview-09-2025).
# GEMINI_LIVE_MODEL=

# --- Supabase persistence (optional) ---
# Without these, live sessions still run; tool calls just are not saved.
# The schema in supabase/migrations/ is already applied to the project. The service-role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OEM manual RAG (npm run oem:ingest / oem:search) ---
# Embeddings are 1536-dim to match oem_knowledge_chunks.embedding vector(1536).
# gemini -> gemini-embedding-001 @1536 (uses GEMINI_API_KEY above)
# openai -> text-embedding-3-small (needs OPENAI_API_KEY)
# Pick one and keep it: vectors from different models can't be searched together.
# EMBEDDING_PROVIDER=gemini
# OPENAI_API_KEY=
